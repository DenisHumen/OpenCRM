{
  "uid": "opencrm-site",
  "title": "OpenCRM — сайт",
  "description": "Что видит посетитель: доступность снаружи, время ответа, доли ошибок, сертификат, копии и деплой.",
  "tags": [
    "opencrm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 20,
      "type": "stat",
      "title": "Требует внимания сейчас",
      "description": "Сколько правил из docker/monitoring/prometheus/rules сработало прямо сейчас. «Спокойно» на зелёном — ни одного: это ОТВЕТ, а не отсутствие данных, поэтому в запросе стоит `or vector(0)`. Пустой панели здесь быть не может.",
      "datasource": {
        "type": "prometheus",
        "uid": "opencrm-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "Спокойно",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Спокойно",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "instant": true,
          "legendFormat": "тревог"
        }
      ]
    },
    {
      "id": 21,
      "type": "table",
      "title": "Действующие тревоги",
      "description": "Пустая таблица означает «всё спокойно»: ряд ALERTS существует только пока тревога горит. Столбец «Висит» считается от ALERTS_FOR_STATE — это момент, когда условие сработало, то есть выдержка `for` в него входит. Текст берётся из подстановки по имени правила: новое правило без подстановки уронит tests/test_monitoring_dashboards.py, а не покажет пустую клетку.",
      "datasource": {
        "type": "prometheus",
        "uid": "opencrm-prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 18,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - ALERTS_FOR_STATE) and ignoring(alertstate) ALERTS{alertstate=\"firing\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "installation": true,
              "job": true,
              "__name__": true,
              "alertstate": true
            },
            "renameByName": {
              "severity": "Важность",
              "alertname": "Что случилось",
              "instance": "Где",
              "service": "Служба",
              "Value": "Висит"
            },
            "indexByName": {
              "severity": 0,
              "alertname": 1,
              "instance": 2,
              "service": 3,
              "Value": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "Спокойно",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Важность"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "text": "критично",
                        "color": "red",
                        "index": 0
                      },
                      "warning": {
                        "text": "внимание",
                        "color": "orange",
                        "index": 1
