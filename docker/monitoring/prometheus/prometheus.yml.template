# Prometheus: что и как часто спрашивать. Шаблон — из-за `__SITE_URL__`,
# подстановку делает docker/monitoring/prometheus/entrypoint.sh.
#
# **Интервал 30 секунд, а не 15.** Каждая точка ряда — это байты на диске
# навсегда, а мониторинг не имеет права стать самой тяжёлой частью сервера.
# Тридцати секунд хватает всему, ради чего он заводился: правило «сайт не
# отвечает 2 минуты» видит четыре промаха подряд, а не два.

global:
  scrape_interval: 30s
  scrape_timeout: 10s
  evaluation_interval: 30s
  external_labels:
    installation: opencrm

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets: ["alertmanager:9093"]

scrape_configs:
  # --- главное: сайт глазами постороннего --------------------------------
  #
  # Идёт через blackbox по публичному адресу, то есть через настоящий nginx,
  # настоящий 443 и настоящий сертификат. Отсюда же берётся срок сертификата
  # (`probe_ssl_earliest_cert_expiry`) — отдельного экспортёра для этого не
  # нужно.
  - job_name: site
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - __SITE_URL__/healthz
          - __SITE_URL__/
    relabel_configs:
      # Цель уезжает в параметр запроса, а сам запрос — в blackbox. Без этой
      # перестановки Prometheus ходил бы прямо на сайт и получал HTML вместо
      # метрик.
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox:9115

  # --- хост: процессор, память, подкачка, место ---------------------------
  - job_name: node
    static_configs:
      - targets: ["node-exporter:9100"]

  # --- контейнеры: живы ли, здоровы ли, сколько едят, сколько раз падали ---
  - job_name: containers
    static_configs:
      - targets: ["containers:9110"]

  # --- приложение: размер базы, свежесть копии, исход деплоя --------------
  #
  # Напрямую по сети compose, минуя nginx: снаружи этот адрес закрыт
  # (docker/nginx/templates/locations.inc), и открывать его незачем.
  - job_name: opencrm-app
    metrics_path: /api/v1/metrics
    static_configs:
      - targets: ["app:8000"]

  # --- база: соединения, замки, буферный пул, медленные запросы -----------
  #
  # `metric_relabel_configs` с `keep` — обязательная часть, а не украшение.
  # Замерено на стенде: mysqld-exporter отдаёт 992 ряда даже с урезанным
  # набором собирателей, а всего в этом Prometheus их было 2144. То есть
  # ОДНА новая служба увеличила бы хранилище наполовину — и уткнулась бы в
  # потолок 512 МБ раньше, чем истекут пятнадцать дней хранения.
  #
  # Список — ровно то, по чему нарисованы панели, как и у node-exporter. Ряда
  # `up{job="mysql"}` он не касается: тот рождается в самом Prometheus уже
  # после этой обработки, поэтому «экспортёр не отвечает» видно всегда.
  #
  # Добавили панель про базу — допишите метрику сюда, иначе она никогда не
  # появится. Стережёт tests/test_monitoring_dashboards.py: он сверяет
  # запросы дашбордов с этим самым списком.
  #
  # То же и для ПРАВИЛ ТРЕВОГ, и там цена ошибки выше. Панель по непрошедшей
  # метрике видно сразу — она пуста; правило по ней выглядит написанным,
  # проходит `promtool check rules` и молчит ОДИНАКОВО при исправной и при
  # задыхающейся базе. Эту связку стережёт
  # tests/test_monitoring.py::test_metrika_kazhdogo_pravila_dodet_cherez_otbor.
  #
  # Переносить регулярное выражение на несколько строк НЕЛЬЗЯ: свёрнутый блок
  # `>-` склеивает их пробелом, и отбор перестанет совпадать вообще ни с чем.
  - job_name: mysql
    static_configs:
      - targets: ["db-exporter:9104"]
    metric_relabel_configs:
      - source_labels: [__name__]
        action: keep
        regex: >-
          mysql_up|mysql_global_status_(threads_connected|threads_running|max_used_connections|aborted_connects|slow_queries|queries|innodb_row_lock_waits|innodb_row_lock_current_waits|innodb_buffer_pool_read_requests|innodb_buffer_pool_reads|buffer_pool_pages)|mysql_global_variables_(max_connections|innodb_buffer_pool_size|innodb_page_size)

  # --- Redis: память против потолка, вытеснения, попадания, задержка ------
  #
  # Тот же keep и по той же причине: экспортёр отдаёт 367 рядов, а нужны из них
  # полтора десятка. `redis_commands_*` оставлены целиком — они с меткой `cmd`,
  # и без них не посчитать среднюю задержку команды.
  - job_name: redis
    static_configs:
      - targets: ["redis-exporter:9121"]
    metric_relabel_configs:
      - source_labels: [__name__]
        action: keep
        regex: >-
          redis_up|redis_memory_used_bytes|redis_memory_max_bytes|redis_evicted_keys_total|redis_keyspace_hits_total|redis_keyspace_misses_total|redis_connected_clients|redis_blocked_clients|redis_rejected_connections_total|redis_commands_duration_seconds_total|redis_commands_total

  # --- доли ответов и время ответа из журнала nginx -----------------------
  #
  # Считает promtail на лету, пока разбирает журнал (docker/monitoring/promtail).
  # Это единственный источник, который видит и 502 от самого nginx, — приложение
  # о них не знает по определению, потому что в этот момент его нет.
  #
  # Живёт в профиле `monitoring-logs`. Профиль выключен — цель просто не
  # отвечает, и правила, написанные через `absent`-безопасные выражения, молчат.
  - job_name: nginx-logs
    static_configs:
      - targets: ["promtail:9080"]

  # --- сам мониторинг -----------------------------------------------------
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: alertmanager
    static_configs:
      - targets: ["alertmanager:9093"]

  - job_name: blackbox
    static_configs:
      - targets: ["blackbox:9115"]
