# Третье состояние канала тревог: АВАРИИ доставляет CRM, с кнопками.
#
# Соседние два — `alertmanager.yml.template` (всё прямо в телеграм, как было
# всегда) и `alertmanager-silent.yml` (канал не настроен). Выбор делает
# `entrypoint.sh`, и делает его заново каждые пять минут: пока CRM отвечает
# «готова», аварии идут сюда; перестала — возвращаются на прямой путь сами.
#
# --- зачем отдельный файл, а не правка соседнего ------------------------------
#
# Затем же, зачем отдельный `alertmanager-silent.yml`: это не оттенок настройки,
# а РАЗНОЕ устройство доставки. У аварии здесь нет ни `bot_token`, ни
# `parse_mode`, ни шаблона сообщения — текст собирает CRM, потому что только она
# умеет приложить к нему клавиатуру. Слить оба файла в один значило бы держать в
# нём две несовместимые половины и выбирать между ними условием внутри YAML,
# которого в YAML нет.
#
# --- почему предупреждения остались на прямом пути ----------------------------
#
# **Предупреждение обязано приходить БЕЗ ЗВУКА**, и это не мелочь оформления:
# звенящее ночью «работает, но так дальше нельзя» учит выключать звук всему
# чату, а выключенный звук чата — это выключенный звук и у аварии. Довод
# записан в соседнем шаблоне и стоил проекту отдельного разбора.
#
# Отправка через CRM сегодня звук выключать не умеет: `poslat_s_knopkami` в
# `core/services/telegram_service.py` не принимает `disable_notification`.
# Значит выбор был между двумя потерями — кнопки у предупреждений или тишина
# ночью, — и тишина дороже: кнопку «принято» жмут у аварии, а не у
# «соединений к базе 82%».
#
# Как только `poslat_s_knopkami` научится молчать, вторая строка маршрута
# переедет на `opencrm`, а приёмник `telegram-tiho` уйдёт отсюда целиком.
#
# Токен бота при этом подставляется только в него: аварию отправляет бот ФИРМЫ
# (его токен лежит в базе CRM), потому что нажатие кнопки приходит вебхуком, а
# вебхук в этой системе есть только у него. Разбор — в
# `core/services/trevogi_service.py`.

global:
  resolve_timeout: 5m

# Следствие не шлёт второго сообщения — копия из соседнего файла и обязана ею
# оставаться. Инхибиция работает ДО выбора приёмника, то есть одинаково на всех
# трёх путях доставки; разъехавшись, эти списки означали бы, что на одном пути
# лежащий сайт даёт одно сообщение, а на другом шесть. Сторож на совпадение —
# `tests/test_trevogi.py`.
inhibit_rules:
  - source_matchers: [alertname="SiteDown"]
    target_matchers:
      - alertname=~"SiteSlow|HighErrorRate|HighClientErrorRate|ContainerUnhealthy|RateLimiterUnavailable"
    equal: []
  - source_matchers: [alertname="RedisDown"]
    target_matchers: [alertname="RateLimiterUnavailable"]
    equal: []

route:
  receiver: opencrm
  # Группировка по имени правила остаётся, но значит теперь меньше: CRM шлёт
  # ОТДЕЛЬНОЕ сообщение на каждую тревогу внутри группы, и это не небрежность.
  # Кнопка «принято» относится к одной тревоге; одна кнопка на группу из трёх
  # означала бы «принял что-то из этого», а silence по группе заглушил бы и то,
  # чего человек не видел.
  group_by: [alertname]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 24h
  routes:
    # Повторы у критического чаще — как и раньше. Смысл повтора при этом другой:
    # CRM второго сообщения не шлёт (у горящей тревоги оно одно), и повтор здесь
    # работает как настойчивая попытка доставки, если первая не удалась.
    - matchers: [severity="critical"]
      receiver: opencrm
      repeat_interval: 1h
    # Прямо в телеграм и молча — ровно как на прежнем пути.
    - matchers: [severity="warning"]
      # Тем же приёмником, что и авария: звук у предупреждения выключает сама
      # служба (`trevogi_service`), по метке важности. Раньше здесь стоял
      # отдельный приёмник — только потому, что отправка через CRM не умела
      # молчать; научилась — вторая копия оформления ушла отсюда целиком.
      receiver: opencrm
      repeat_interval: 24h

receivers:
  - name: opencrm
    webhook_configs:
      # Имя службы, а не адрес: внутри сети compose приложение всегда `app`, и
      # адрес контейнера меняется при каждом пересоздании. Порт 8000 наружу не
      # публикуется — то есть этот путь физически не виден из интернета, и на
      # этом же держится защита приёма (см. web/api/routes/trevogi.py).
      - url: http://app:8000/api/v1/alerts/webhook
        # Отбой нужен: по нему CRM перерисовывает сообщение в чате из «горит» в
        # «погасло» и освобождает память о тревоге. Без него принятая вчера
        # тревога осталась бы в чате красной навсегда, а зажёгшаяся снова —
        # молчала бы, считаясь повтором.
        send_resolved: true
        # Ноль означает «без предела»: пакет уезжает целиком, ничего не
        # отсекается. Предел здесь был бы опасен молча — отброшенные тревоги
        # не попали бы ни в чат, ни в журнал.
        #
        # Повтор всего пакета при неудаче безвреден: CRM помнит каждую тревогу
        # по её отпечатку и вторым сообщением уже отправленную не делает.
        max_alerts: 0

  # Дословная копия приёмника из `alertmanager.yml.template`, включая текст
  # сообщения. Копия здесь неизбежна: якорь YAML живёт внутри одного файла, а
  # приёмника `telegram` тут нет вовсе. Чтобы копия не разъехалась молча — а
  # разъехавшись, она означала бы, что половина предупреждений оформлена
  # по-старому, — на неё стоит сторож в `tests/test_trevogi.py`: он сверяет оба
  # файла посимвольно.
  - name: telegram-tiho
    telegram_configs:
      - bot_token: __TELEGRAM_TOKEN__
        chat_id: __TELEGRAM_CHAT__
        api_url: __TELEGRAM_API__
        parse_mode: HTML
        send_resolved: true
        disable_notifications: true
        message: |-
          {{- $kritichno := eq .CommonLabels.severity "critical" -}}
          {{- $mnogo := gt (len .Alerts) 1 -}}
          {{ if eq .Status "firing" }}🔴{{ else }}🟢{{ end }} {{ if $kritichno }}🆘{{ else }}⚠️{{ end }} <b>{{ if eq .Status "firing" }}{{ if $kritichno }}Авария{{ else }}Предупреждение{{ end }}{{ else }}Отбой{{ end }} · {{ (index .Alerts 0).Annotations.summary }}</b>{{ if $mnogo }} · тревог: {{ len .Alerts }}{{ end }}
          {{ range .Alerts }}
          {{ if $mnogo }}<b>{{ .Annotations.summary }}</b>
          {{ end }}<blockquote expandable>{{ .Annotations.description }}
          {{ if eq .Status "firing" }}⏱ горит уже {{ .StartsAt | since | humanizeDuration }}{{ else }}⏱ длилось {{ .EndsAt.Sub .StartsAt | humanizeDuration }}{{ end }}</blockquote>
          {{ end }}
