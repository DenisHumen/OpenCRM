# Куда уходят тревоги. Подстановку токена и чата делает
# docker/monitoring/alertmanager/entrypoint.sh — в репозитории их нет.
#
# Канал тот же, что у автообновления: бот уже настроен, чат уже читают, и
# заводить второй значит завести второй, который читать перестанут.

global:
  # Сколько ждать, прежде чем считать тревогу утихшей, если Prometheus замолчал.
  # Больше `evaluation_interval`, иначе каждая пропущенная проверка выглядела бы
  # как «починилось».
  resolve_timeout: 5m

route:
  receiver: telegram
  # Группируем по имени правила: три контейнера, перезапускающиеся из-за одной
  # причины, — это одно сообщение, а не три.
  group_by: [alertname]
  group_wait: 30s
  group_interval: 5m
  # Раз в сутки о том, что и так известно, — этого достаточно, чтобы не забыть,
  # и мало, чтобы не приучить пролистывать.
  repeat_interval: 24h
  routes:
    # Критическое напоминает о себе чаще: сайт лежит — это не то, о чём стоит
    # вспомнить завтра.
    - matchers: [severity="critical"]
      receiver: telegram
      repeat_interval: 1h

receivers:
  - name: telegram
    telegram_configs:
      - bot_token: __TELEGRAM_TOKEN__
        chat_id: __TELEGRAM_CHAT__
        # Адрес API вынесен наружу по двум причинам, и обе настоящие: в части
        # стран Telegram блокируют, и тогда нужен свой прокси; а на стенде на это
        # место ставится заглушка — иначе «оповещение действительно уходит»
        # проверить нечем, кроме как отправив сообщение в живой чат.
        api_url: __TELEGRAM_API__
        # Разметка — HTML, и это не то же самое, что было.
        #
        # Выключена она была из-за MarkdownV2: там экранировать надо
        # восемнадцать символов, а в текст тревоги попадают адреса, команды и
        # подчёркивания. Любой пропущенный — и Telegram отбивает сообщение
        # целиком, то есть об аварии никто не узнаёт именно потому, что
        # сообщение было подробным.
        #
        # В HTML опасных символов три, и все три здесь экранируются явно —
        # `reReplaceAll` по каждому. Порядок обязателен: `&` первым, иначе он
        # съел бы амперсанды, которые сам же и породил.
        parse_mode: HTML
        send_resolved: true
        # Ссылку на панель не разворачиваем карточкой: она заняла бы пол-экрана
        # поверх текста тревоги.
        disable_notifications: false
        message: |-
          {{ if eq .Status "firing" }}🔴 <b>Тревога</b> ({{ .Alerts.Firing | len }}){{ else }}🟢 <b>Всё в порядке</b>{{ end }}
          {{ range .Alerts }}
          <b>{{ .Annotations.summary | reReplaceAll "&" "&amp;" | reReplaceAll "<" "&lt;" | reReplaceAll ">" "&gt;" }}</b>
          <blockquote expandable>{{ .Annotations.description | reReplaceAll "&" "&amp;" | reReplaceAll "<" "&lt;" | reReplaceAll ">" "&gt;" }}</blockquote>
          {{ end }}
