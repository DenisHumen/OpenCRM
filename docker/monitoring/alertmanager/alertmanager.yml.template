# Куда уходят тревоги. Подстановку токена и чата делает
# docker/monitoring/alertmanager/entrypoint.sh — в репозитории их нет.
#
# Канал тот же, что у автообновления: бот уже настроен, чат уже читают, и
# заводить второй значит завести второй, который читать перестанут.
#
# Раз чат один на всё, у сообщений тут ровно одна задача: за один взгляд на
# список чатов ответить «идти смотреть или нет». Отсюда устройство первой
# строки — значок состояния, значок важности и СУТЬ, а не «Тревога (1)».
# Подробности и команды — ниже, под катом.

global:
  # Сколько ждать, прежде чем считать тревогу утихшей, если Prometheus замолчал.
  # Больше `evaluation_interval`, иначе каждая пропущенная проверка выглядела бы
  # как «починилось».
  resolve_timeout: 5m

# Следствие не шлёт второго сообщения.
#
# Лежащий сайт зажигает разом полдюжины правил: снаружи не отвечает никто, доли
# ответов улетают, проверки здоровья не проходят. Человеку от этого не легче —
# чинит он ОДНУ поломку, а сообщений получает шесть, и в следующий раз читает
# только первое. Здесь названы те связи, где следствие не добавляет ни знания,
# ни действия: причина уже пришла и уже названа.
#
# `equal: []` — намеренно. Обычно инхибицию сужают общей меткой (тот же хост,
# тот же кластер), но установка здесь одна на сервер: если сайт лёг, он лёг
# целиком, и делить не по чему.
inhibit_rules:
  # Сайт не отвечает — всё остальное про сайт вторично.
  - source_matchers: [alertname="SiteDown"]
    target_matchers:
      - alertname=~"SiteSlow|HighErrorRate|HighClientErrorRate|ContainerUnhealthy|RateLimiterUnavailable"
    equal: []
  # Redis не отвечает — «счётчик попыток недоступен» это ровно он и есть,
  # только замеченный со стороны приложения и только когда кто-то попробовал
  # войти. Два сообщения об одной беде.
  - source_matchers: [alertname="RedisDown"]
    target_matchers: [alertname="RateLimiterUnavailable"]
    equal: []

route:
  receiver: telegram
  # Группируем по имени правила: три контейнера, перезапускающиеся из-за одной
  # причины, — это одно сообщение, а не три.
  group_by: [alertname]
  group_wait: 30s
  group_interval: 5m
  # Раз в сутки о том, что и так известно, — этого достаточно, чтобы не забыть,
  # и мало, чтобы не приучить пролистывать.
  repeat_interval: 24h
  routes:
    # Критическое напоминает о себе чаще: сайт лежит — это не то, о чём стоит
    # вспомнить завтра. И звенит: разбудить оно обязано.
    - matchers: [severity="critical"]
      receiver: telegram
      repeat_interval: 1h
    # Предупреждение приходит БЕЗ ЗВУКА, и это не мелочь оформления.
    # «Работает, но так дальше нельзя» не требует человека сейчас; звенящее
    # ночью предупреждение учит выключать звук у всего чата — вместе с
    # авариями. Значок в списке чатов при этом остаётся, утром его увидят.
    - matchers: [severity="warning"]
      receiver: telegram-tiho
      repeat_interval: 24h

receivers:
  - name: telegram
    telegram_configs:
      - bot_token: __TELEGRAM_TOKEN__
        chat_id: __TELEGRAM_CHAT__
        # Адрес API вынесен наружу по двум причинам, и обе настоящие: в части
        # стран Telegram блокируют, и тогда нужен свой прокси; а на стенде на это
        # место ставится заглушка — иначе «оповещение действительно уходит»
        # проверить нечем, кроме как отправив сообщение в живой чат.
        api_url: __TELEGRAM_API__
        # --- разметка и экранирование ---
        #
        # `parse_mode: HTML` тут делает ДВА дела, и второе важнее первого.
        #
        # 1. Разрешает `<b>` и `<blockquote>`.
        # 2. Заставляет Alertmanager рендерить это сообщение через
        #    `html/template` вместо `text/template`. А `html/template`
        #    экранирует ПОДСТАНОВКИ, оставляя литеральный текст шаблона в покое:
        #    наши `<b>` остаются тегами, а `<script>` из описания тревоги
        #    приезжает как `&lt;script&gt;`.
        #
        # Проверено на живом Alertmanager v0.28.0 (той самой версии, что
        # закреплена в docker-compose.yml) заглушкой вместо Telegram:
        #
        #   описание `less< more> amp&`  →  `less&lt; more&gt; amp&amp;`
        #   тот же текст без parse_mode  →  `less< more> amp&`
        #
        # Отсюда правило, обратное тому, что кажется разумным: **экранировать
        # руками здесь НЕЛЬЗЯ**. Цепочка `reReplaceAll "&" "&amp;" | ...`
        # стояла тут раньше и портила текст, потому что поверх неё ложилось
        # экранирование самого Alertmanager: `<script>` доезжал до чата как
        # `&amp;lt;script&amp;gt;`. Одно экранирование — верно, два — мусор.
        #
        # Запасного пути, как у `deploy/notify.py` (там отбитое сообщение
        # уходит повторно плоским текстом), у Alertmanager нет: на 400 он
        # выбросит сообщение об аварии совсем. Поэтому единственная защита —
        # то, что подстановки экранируются гарантированно и без нашего участия.
        # Стережёт `tests/test_monitoring.py`.
        parse_mode: HTML
        send_resolved: true
        disable_notifications: false
        # Первая строка — единственное, что видно в списке чатов.
        #
        #   🔴 🆘 Авария · Сайт не отвечает: https://example.com/healthz
        #   🟢 ⚠️ Отбой · Доля ответов 4xx — 63.33% (порог 40%)
        #
        # Значка два, и они разные по смыслу: 🔴/🟢 — горит или погасло,
        # 🆘/⚠️ — надо ли вставать сейчас. Прежняя первая строка («🔴 Тревога
        # (1)») отвечала только на первый вопрос, а на главный — «что именно» —
        # приходилось открывать чат.
        #
        # Само число в заголовке («доля 4xx — 63.33%», а не «выше 40%») приходит
        # из summary правил: там оно и считается, см.
        # docker/monitoring/prometheus/rules/opencrm.yml.
        #
        # `⏱ горит уже …` отвечает на вопрос, который задают вторым: моргнуло
        # или стоит. Одно и то же «сайт не отвечает» через две минуты и через
        # два часа — это разные новости.
        message: &soobshchenie |-
          {{- $kritichno := eq .CommonLabels.severity "critical" -}}
          {{- $mnogo := gt (len .Alerts) 1 -}}
          {{ if eq .Status "firing" }}🔴{{ else }}🟢{{ end }} {{ if $kritichno }}🆘{{ else }}⚠️{{ end }} <b>{{ if eq .Status "firing" }}{{ if $kritichno }}Авария{{ else }}Предупреждение{{ end }}{{ else }}Отбой{{ end }} · {{ (index .Alerts 0).Annotations.summary }}</b>{{ if $mnogo }} · тревог: {{ len .Alerts }}{{ end }}
          {{ range .Alerts }}
          {{ if $mnogo }}<b>{{ .Annotations.summary }}</b>
          {{ end }}<blockquote expandable>{{ .Annotations.description }}
          {{ if eq .Status "firing" }}⏱ горит уже {{ .StartsAt | since | humanizeDuration }}{{ else }}⏱ длилось {{ .EndsAt.Sub .StartsAt | humanizeDuration }}{{ end }}</blockquote>
          {{ end }}
  # Тот же бот, тот же чат, тот же текст — разница ровно одна: телефон молчит.
  # Якорь `*soobshchenie` держит текст в одном экземпляре: разъехавшиеся копии
  # шаблона означали бы, что половина тревог оформлена по-старому, и заметить
  # это было бы нечем.
  - name: telegram-tiho
    telegram_configs:
      - bot_token: __TELEGRAM_TOKEN__
        chat_id: __TELEGRAM_CHAT__
        api_url: __TELEGRAM_API__
        parse_mode: HTML
        send_resolved: true
        disable_notifications: true
        message: *soobshchenie
