# OpenCRM — nginx с TLS. Подставляется, когда сертификат для домена уже выпущен.

# Формат журнала доступа: на уровне http, потому что `log_format` и `map` в
# server-блоке не живут. По этим строкам мониторинг считает доли ответов.
include /opencrm/templates/logging.inc;

server {
    listen 80;
    server_name ${OPENCRM_DOMAIN};

    # Резолвер нужен и здесь: /healthz ниже ходит в приложение по имени, а
    # блок на 443 со своим resolver'ом сюда не распространяется.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # каталог проверки остаётся на 80 и БЕЗ редиректа: продление ходит именно сюда
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # /healthz тоже остаётся на 80 и БЕЗ редиректа.
    #
    # Его спрашивают только свои и только с этой же машины: меню скрипта,
    # `wait_health` и автообновление — все по http://127.0.0.1/healthz. За
    # редиректом они получали 301 вместо ответа, и после включения HTTPS сайт
    # объявлялся мёртвым, будучи живым. Хуже того, на этом падал health-check
    # деплоя: обновление откатывалось само, откат тоже «не поднимался», и
    # приходило «нужен человек» — при полностью работающем сайте.
    #
    # Гнать эти проверки через HTTPS нельзя: сертификат выписан на домен, а не
    # на 127.0.0.1, и обращение по имени домена с самого сервера упирается в
    # hairpin NAT. Проверка здоровья не должна зависеть ни от TLS, ни от DNS.
    location = /healthz {
        set $opencrm_health app;
        proxy_pass http://$opencrm_health:8000/healthz;
        proxy_set_header Host $host;
        access_log off;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${OPENCRM_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${OPENCRM_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${OPENCRM_DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 220m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    # полгода: домен уже отдаёт HTTPS, и откат на http ломает cookie сессии
    add_header Strict-Transport-Security "max-age=15768000" always;

    include /opencrm/templates/locations.inc;
}
