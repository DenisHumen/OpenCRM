# Что nginx рассказывает о запросе тому, кому его передаёт.
#
# Отдельным файлом, потому что мест стало шесть: корень сайта, медиа витрины,
# два входа в CRM со своим ограничителем потока, панель мониторинга и её вход.
# Шесть копий четырёх строк разъезжаются при первой же правке одной из них, и
# разъезжаются молча — а среди этих строк `X-Forwarded-For`, от которого зависит
# определение адреса клиента (`core client_ip`, `docs/ekspluatatsiya/07-bezopasnost.md`), то есть
# ВСЯ защита от подбора PIN, пароля и номеров бланков. Потеряй её один блок из
# шести — и ограничитель на этом маршруте начнёт считать всех посетителей за
# одного, не сказав ни слова.
#
# `proxy_pass` и `set` здесь НЕТ намеренно: адрес у каждого свой (приложение или
# Grafana), и общим быть не может. `error_page` тоже свой: страница обслуживания
# у сайта, «мониторинг выключен» у панели.
proxy_set_header Host $host;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;

# **`proxy_read_timeout` отсюда УЕХАЛ, и это не потеря, а исправление.**
#
# Он здесь и не был заголовком: файл существует ради `X-Forwarded-For`, от
# которого зависит определение адреса клиента, а значит вся защита от подбора.
# Таймаут же у каждого места свой по существу — живому соединению панели нужен
# час, обычной ручке ста двадцати секунд более чем достаточно.
#
# Пока он лежал здесь, это мешало прямо: nginx на повторный
# `proxy_read_timeout` в одном блоке отвечает `directive is duplicate` и НЕ
# ПОДНИМАЕТСЯ. То есть блоку со своим таймаутом приходилось отказываться от
# всего файла целиком — вместе с `X-Forwarded-For`. Ровно так и было сделано
# для живого соединения Grafana, и сторож `tests/test_public_surface.py` это
# поймал: проход внутрь без общего файла заголовков он считает нарушением, и
# правильно считает.
#
# Теперь таймаут пишется в каждом блоке своей строкой, рядом с `proxy_pass`. Их
# шесть, и это тот случай, когда шесть строк лучше одной: они РАЗНЫЕ, и общей
# быть не могут.
