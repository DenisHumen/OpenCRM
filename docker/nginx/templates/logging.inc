# Формат журнала доступа и то, что в него НЕ попадает.
#
# Файл подключается на уровне `http` (директивы `log_format` и `map` в
# `server` не живут), поэтому его включают оба шаблона — и он же единственное
# место, где формат описан. Envsubst его не трогает: переменные здесь
# принадлежат nginx, а не шаблонизатору.
#
# Зачем JSON. По этим строкам promtail считает доли ответов 4xx/5xx, RPS и время
# ответа — то есть числа, по которым приходит оповещение «доля ошибок выше
# порога». Разбирать регулярным выражением обычный `combined` можно, но он
# ломается на первом же поле с пробелом, и ломается молча: счётчик просто
# перестаёт расти.
#
# **Чего в журнале нет — и почему это правило.** Логи уезжают в Loki и лежат
# там неделю; всё, что туда попало, переживает и запрос, и того, кто его послал.
# Поэтому:
#
# * нет адреса клиента. Проект хэширует IP даже в своём журнале просмотров
#   (`OPENCRM_IP_HASH_SALT`), и класть его открытым текстом в соседнее
#   хранилище значило бы обойти собственную защиту сбоку;
# * нет `User-Agent`, `Referer` и строки запроса. Первые два — отпечаток
#   посетителя, третья — место, где оказываются токены из ссылок;
# * путь обрезан там, где в нём лежит секрет. `/b/<токен>` — это ссылка на
#   витрину, действующая без входа в систему: попади она в журнал целиком, и
#   всякий, у кого есть доступ к логам, открывает чужую доску. То же у `/d/` и
#   `/media/`.

map $uri $opencrm_log_path {
    default      $uri;
    # Витрина доски: в пути токен доступа.
    "~^/b/"      "/b/*";
    # Состояние заказа по номеру с квитанции.
    "~^/d/"      "/d/*";
    # Файлы работ: в пути идентификатор работы.
    "~^/media/"  "/media/*";
}

log_format opencrm_json escape=json
    '{"time":"$time_iso8601"'
    ',"status":"$status"'
    ',"request_time":"$request_time"'
    ',"upstream_time":"$upstream_response_time"'
    ',"method":"$request_method"'
    ',"path":"$opencrm_log_path"'
    ',"bytes":"$body_bytes_sent"'
    ',"proto":"$server_protocol"}';
