# Переменные docker compose. Скопируйте в docker/.env и заполните.
# Настройки самого приложения живут отдельно — в config/.env.

# Домен сайта. Пусто — работаем по HTTP (годится для локальной сети и запуска по IP);
# заполнено — после выпуска сертификата nginx сам включит HTTPS и редирект с 80.
OPENCRM_DOMAIN=

# Куда класть состояние. По умолчанию — ~/opencrm у того, кто запускает compose.
#OPENCRM_HOME=/home/studio/opencrm

# UID и GID владельца этих каталогов: контейнер приложения работает под ними,
# иначе не сможет писать в примонтированную домашнюю папку.
# Узнать свои:  id -u  и  id -g
OPENCRM_UID=1000
OPENCRM_GID=1000

# Сколько доверенных прокси стоит перед приложением. По умолчанию 1 — это nginx
# из этого же compose. Появился ещё один впереди (Cloudflare, балансировщик
# облака) — ставьте 2, иначе все посетители сольются в пару его адресов: лимит
# на подбор PIN станет общим на всех, а статистика просмотров — бессмысленной.
#OPENCRM_TRUSTED_PROXY_HOPS=1

# Язык, на котором говорит opencrm.sh: ru или en. Спрашивается один раз при
# установке и сохраняется сюда, чтобы cron, systemd и повторные запуски
# отвечали так же. Переменная окружения OPENCRM_LANG перебивает это значение.
OPENCRM_LANG=ru
