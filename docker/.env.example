# Переменные docker compose. Скопируйте в docker/.env и заполните.
# Настройки самого приложения живут отдельно — в config/.env.

# Домен сайта. Пусто — работаем по HTTP (годится для локальной сети и запуска по IP);
# заполнено — после выпуска сертификата nginx сам включит HTTPS и редирект с 80.
OPENCRM_DOMAIN=

# Куда класть состояние. По умолчанию — ~/opencrm у того, кто запускает compose.
#OPENCRM_HOME=/home/studio/opencrm

# UID и GID владельца этих каталогов: контейнер приложения работает под ними,
# иначе не сможет писать в примонтированную домашнюю папку.
# Узнать свои:  id -u  и  id -g
OPENCRM_UID=1000
OPENCRM_GID=1000

# Сколько доверенных прокси стоит перед приложением. По умолчанию 1 — это nginx
# из этого же compose. Появился ещё один впереди (Cloudflare, балансировщик
# облака) — ставьте 2, иначе все посетители сольются в пару его адресов: лимит
# на подбор PIN станет общим на всех, а статистика просмотров — бессмысленной.
#OPENCRM_TRUSTED_PROXY_HOPS=1

# Язык, на котором говорит opencrm.sh: ru или en. Спрашивается один раз при
# установке и сохраняется сюда, чтобы cron, systemd и повторные запуски
# отвечали так же. Переменная окружения OPENCRM_LANG перебивает это значение.
OPENCRM_LANG=ru

# --- наблюдение за сервером (блок «Мониторинг») ---
#
# Стек поднимается профилями compose и по умолчанию выключен: полный набор
# наблюдателей забирает около 245 МиБ, а на VPS с двумя гигабайтами сайт живёт
# с той же памяти. Установщик выбирает состав сам, глядя на машину.

# Пароль к Grafana. Наружу порт не публикуется — она открывается через тот же
# nginx на /monitoring/, — но пароль всё равно обязателен: панель без него
# выдаёт карту всей системы каждому, кто угадал адрес. Задаётся при установке.
#OPENCRM_GRAFANA_PASSWORD=

# Адрес, по которому проверка стучится СНАРУЖИ. Именно снаружи, а не изнутри
# контейнера: тот самый случай, ради которого всё затевалось, — приложение
# отвечало на localhost, а снаружи не отвечал никто, потому что nginx не
# поднялся. Проверка изнутри показала бы «всё хорошо».
#OPENCRM_MONITOR_URL=https://example.com/healthz

# Оповещения идут в тот же Telegram, что и автообновление. Пусто — тревоги
# останутся только в панели, то есть их увидит тот, кто и так туда смотрит.
#OPENCRM_MONITORING_TELEGRAM_TOKEN=
#OPENCRM_MONITORING_TELEGRAM_CHAT_ID=
# Адрес API Telegram. Меняется только в проверках — чтобы тревога уходила в
# заглушку, а не живому человеку.
#OPENCRM_MONITORING_TELEGRAM_API=https://api.telegram.org
