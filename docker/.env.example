# Переменные docker compose. Скопируйте в docker/.env и заполните.
# Настройки самого приложения живут отдельно — в config/.env.

# Домен сайта. Пусто — работаем по HTTP (годится для локальной сети и запуска по IP);
# заполнено — после выпуска сертификата nginx сам включит HTTPS и редирект с 80.
OPENCRM_DOMAIN=

# Куда класть состояние. По умолчанию — ~/opencrm у того, кто запускает compose.
#OPENCRM_HOME=/home/studio/opencrm

# UID и GID владельца этих каталогов: контейнер приложения работает под ними,
# иначе не сможет писать в примонтированную домашнюю папку.
# Узнать свои:  id -u  и  id -g
OPENCRM_UID=1000
OPENCRM_GID=1000

# Сколько доверенных прокси стоит перед приложением. По умолчанию 1 — это nginx
# из этого же compose. Появился ещё один впереди (Cloudflare, балансировщик
# облака) — ставьте 2, иначе все посетители сольются в пару его адресов: лимит
# на подбор PIN станет общим на всех, а статистика просмотров — бессмысленной.
#OPENCRM_TRUSTED_PROXY_HOPS=1

# --- база и общий счётчик попыток ---
#
# Пароли и профиль compose пишет установщик; руками сюда лезут только при
# разборе поломок. Обе службы описаны в docker-compose.yml.

# Какие службы входят в стек. `mysql` появляется при выборе MySQL, `monitoring`
# и `monitoring-logs` — при включении наблюдения. Правится ПО ОДНОМУ ИМЕНИ:
# перезапись целиком молча выносит из стека соседа (базу или мониторинг).
#COMPOSE_PROFILES=mysql

# База, если выбрали MySQL. Пароли генерирует установщик, файл держится с
# правами 600. Пароль приложения лежит ВТОРОЙ раз — внутри OPENCRM_DB_URL в
# config/.env; разойдясь, они дают «access denied» на первом же старте.
#OPENCRM_DB_NAME=opencrm
#OPENCRM_DB_USER=opencrm
#OPENCRM_DB_PASSWORD=
#OPENCRM_DB_ROOT_PASSWORD=

# Пароль Redis. Служба поднимается ВСЕГДА, в том числе на SQLite: в ней лежит
# общий на все процессы счётчик неудачных попыток входа и PIN. Пусто — Redis
# пускает без пароля любого, кто оказался в сети compose; установщик всегда
# что-нибудь сюда пишет.
#
# Как и у базы, значение лежит вторым местом: адрес с паролем внутри —
# OPENCRM_REDIS_URL в config/.env. Правите руками — правьте оба.
#OPENCRM_REDIS_PASSWORD=

# Сколько памяти Redis отводит под ключи, прежде чем начать вытеснять старые.
# Счётчик попыток — это сотня байт на ключ, и 64 МБ хватает на полмиллиона
# адресов в окне. Потолок обязателен: ключи приходят с улицы (адрес почты,
# хэш IP), и без него перебор набьёт столько, сколько дадут.
#OPENCRM_REDIS_MAXMEMORY=64mb

# Сколько рабочих процессов поднимает uvicorn. Больше одного можно ТОЛЬКО при
# двух условиях сразу: база не SQLite (у неё один писатель) и задан
# OPENCRM_REDIS_URL (иначе счётчик попыток лежит в памяти каждого процесса
# отдельно, и порог защиты от подбора умножается на число процессов — молча).
# Приложение и entrypoint.sh проверяют оба условия и отказываются стартовать.
#OPENCRM_WORKERS=1

# Язык, на котором говорит opencrm.sh: ru или en. Спрашивается один раз при
# установке и сохраняется сюда, чтобы cron, systemd и повторные запуски
# отвечали так же. Переменная окружения OPENCRM_LANG перебивает это значение.
OPENCRM_LANG=ru

# --- наблюдение за сервером (блок «Мониторинг») ---
#
# Стек поднимается профилями compose и по умолчанию выключен: полный набор
# наблюдателей забирает около 245 МиБ, а на VPS с двумя гигабайтами сайт живёт
# с той же памяти. Установщик выбирает состав сам, глядя на машину.

# Пароль к Grafana. Основной вход — через тот же nginx на /monitoring/, но
# пароль обязателен при любом входе: панель без него выдаёт карту всей системы
# каждому, кто угадал адрес. Задаётся при установке.
#OPENCRM_GRAFANA_PASSWORD=

# К какому адресу хоста прибит порт панели (9080 → Grafana 3000).
#
# По умолчанию 127.0.0.1 — то есть снаружи не видно ничего, и это правильное
# умолчание: панель ходит без TLS. С чужой машины к ней заходят туннелем:
#     ssh -L 9080:127.0.0.1:9080 user@server     затем http://localhost:9080/
#
# Нужен вход из локальной сети или по VPN — поставьте сюда частный адрес самого
# сервера, например 10.0.0.130. Тогда панель откроется по http://10.0.0.130:9080/
# для тех, кто уже внутри сети, и ни для кого больше.
#
# 0.0.0.0 здесь запрещён и роняет проверки: это «слушать на всех интерфейсах»,
# то есть отдать панель без TLS и мимо единственной точки входа всему интернету.
#OPENCRM_GRAFANA_BIND=127.0.0.1

# Cookie сессии панели — только по HTTPS. По умолчанию так и есть, и менять
# это стоит ровно в одном случае: панель открывают ТОЛЬКО напрямую по
# http://127.0.0.1:9080 (туннелем), без публичного адреса. Тогда с `true`
# вход не состоится вовсе — верный пароль будет возвращать на форму молча.
#OPENCRM_GRAFANA_COOKIE_SECURE=false

# Порт панели на хосте (внутри Grafana всегда 3000).
#
# Настраивается потому, что 9080 бывает занят, а занятый порт роняет ВЕСЬ стек:
# `compose up` не поднимет ни одной службы, если хоть одна не смогла привязаться.
# Проверить, свободен ли выбранный:  ss -ltnp | grep :8080
#OPENCRM_GRAFANA_PORT=9080

# Адрес, по которому проверка стучится СНАРУЖИ. Именно снаружи, а не изнутри
# контейнера: тот самый случай, ради которого всё затевалось, — приложение
# отвечало на localhost, а снаружи не отвечал никто, потому что nginx не
# поднялся. Проверка изнутри показала бы «всё хорошо».
# Адрес САЙТА, без пути: к нему проверка сама допишет /healthz, а корень
# панели мониторинга собирается как <этот адрес>/monitoring/. С суффиксом
# в значении панель уехала бы на .../healthz/monitoring/.
#OPENCRM_MONITOR_URL=https://example.com

# Куда проверке идти за этим именем — пара «имя сайта» + «адрес в локальной сети».
#
# Нужна там, где сервер стоит за NAT: публичное имя ведёт на роутер, а роутер не
# всякий умеет разворачивать пакет обратно внутрь (hairpin NAT). Сервер тогда не
# может дозвониться до собственного публичного адреса, проверка краснеет ВСЕГДА,
# и правило SiteDown шлёт тревогу при полностью живом сайте.
#
# Пара кладётся в /etc/hosts контейнера проверки: имя остаётся тем же, поэтому
# запрос идёт по имени, попадает в свой же nginx и получает ТОТ САМЫЙ сертификат.
# Проверка сертификата не отключается, просроченный по-прежнему виден.
#
# Заполнять обе строки или ни одной: имя без адреса уводит проверку на 127.0.0.1
# молча. Пишет их `./opencrm.sh` (он же и спрашивает), проверяет `doctor`.
#
# ОГОВОРКА, КОТОРУЮ НАДО ЗНАТЬ: проверка по локальному адресу видит nginx, TLS и
# приложение, но НЕ видит роутер. Отвалится проброс портов — сайт ляжет для всего
# мира, а мониторинг останется зелёным. Закрывается это только внешним
# наблюдателем со стороны: GET /healthz в UptimeRobot или любом аналоге.
#OPENCRM_MONITOR_HOST=example.com
#OPENCRM_MONITOR_IP=10.0.0.130

# Кто ходит в MySQL за метриками. НЕ пользователь приложения и тем более не root:
# наблюдателю нужны три права и ни одной таблицы с данными клиентов.
#
# Обе строки пишет установщик, и он же заводит пользователя в базе:
# `./opencrm.sh monitoring on` (при установке — включение мониторинга). Пароль
# генерируется один раз и больше не меняется: он записан ещё и внутри базы, и
# новый развёл бы половины пары. Команда идемпотентна, поэтому она же и починка
# — после переезда базы или потери пользователя достаточно повторить её.
#
# Руками (например, на чужой базе снаружи контейнера) — так:
#
#   CREATE USER IF NOT EXISTS 'opencrm_exporter'@'%'
#       IDENTIFIED BY '<пароль>' WITH MAX_USER_CONNECTIONS 3;
#   ALTER USER 'opencrm_exporter'@'%'
#       IDENTIFIED BY '<пароль>' WITH MAX_USER_CONNECTIONS 3;
#   GRANT PROCESS, REPLICATION CLIENT ON *.* TO 'opencrm_exporter'@'%';
#   GRANT SELECT ON performance_schema.* TO 'opencrm_exporter'@'%';
#
# ALTER нужен затем, чтобы смена пароля доезжала до УЖЕ существующего
# пользователя: CREATE его не тронет, и файл разошёлся бы с базой навсегда.
# MAX_USER_CONNECTIONS — чтобы наблюдатель не съел последние соединения ровно
# тогда, когда их не хватает и он нужнее всего.
#
# Пусто или пользователь не заведён — метрик базы не будет, и это ВИДНО в двух
# местах: панель «Сбор метрик базы» на дашборде «сервер и контейнеры» краснеет с
# надписью «нет доступа к базе» (а не рисует пустой график, неотличимый от «всё
# спокойно»), и `./opencrm.sh doctor` говорит об этом строкой «метрики базы».
#OPENCRM_DB_EXPORTER_USER=opencrm_exporter
#OPENCRM_DB_EXPORTER_PASSWORD=

# Оповещения идут в тот же Telegram, что и автообновление. Пусто — тревоги
# останутся только в панели, то есть их увидит тот, кто и так туда смотрит.
#OPENCRM_MONITORING_TELEGRAM_TOKEN=
#OPENCRM_MONITORING_TELEGRAM_CHAT_ID=
# Адрес API Telegram. Меняется только в проверках — чтобы тревога уходила в
# заглушку, а не живому человеку.
#OPENCRM_MONITORING_TELEGRAM_API=https://api.telegram.org
