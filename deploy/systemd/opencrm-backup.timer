[Unit]
Description=OpenCRM: ежедневная резервная копия

[Timer]
# 03:30 по Киеву, и пояс назван явно — не ради самой копии, а ради ПОРЯДКА с
# уборкой переписки. `opencrm-telegram-uborka.timer` сознательно стоит на 04:30
# Europe/Kyiv, то есть после копии: уборка, прошедшая раньше, удалила бы
# переписку, которой потом не оказалось бы ни в одной копии за эти сутки.
# Оставь этот юнит без пояса — на UTC-сервере он ушёл бы на 03:30 UTC, а уборка
# встала бы на 01:30 UTC, и она пошла бы ПЕРЕД копией. Пояс здесь — часть
# инварианта «сначала копия, потом удаление», а не украшение.
#
# Пояс стоит внутри выражения: ключа `Timezone=` в секции `[Timer]` у systemd
# нет, он пишет «Unknown key name» в журнал и игнорирует строку.
#
# Цена честная и её стоит знать: в ночь перевода стрелок вперёд (последнее
# воскресенье марта) местных 03:30 не существует — Киев прыгает с 03:00 на
# 04:00, — и копия за эту одну ночь в году не снимается. Уборка в ту же ночь
# идёт как обычно и удаляет по вчерашней копии, а не по сегодняшней.
OnCalendar=*-*-* 03:30:00 Europe/Kyiv
# В 3:30 на VPS просыпаются все соседи по железу разом. Разброс до 20 минут
# уводит копию с этого пика — иначе она снимается медленнее всего именно тогда,
# когда диск и так занят.
RandomizedDelaySec=20m
# Сервер был выключен в назначенный час — копия снимется при первом запуске,
# а не пропустится молча до следующих суток.
Persistent=true

[Install]
WantedBy=timers.target
