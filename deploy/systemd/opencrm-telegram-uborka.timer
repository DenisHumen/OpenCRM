[Unit]
Description=OpenCRM: уборка старой переписки раз в сутки

[Timer]
# 04:30, то есть ПОСЛЕ ночной копии, а не до неё.
#
# Это главное в выборе часа, и довод стоит записать. Копия снимается в 03:30 с
# разбросом до двадцати минут, то есть кончается к четырём. Уборка, поставленная
# раньше копии, удаляла бы переписку, которой потом не оказалось бы ни в одной
# копии за эти сутки — то есть безвозвратно, начиная с той же ночи. Поставленная
# после, она удаляет то, что уже лежит во вчерашней копии, и ошибка в сроке
# остаётся исправимой.
OnCalendar=*-*-* 04:30:00
Timezone=Europe/Kyiv
# Разброс небольшой: соседей по железу в этот час уже нет, а совпасть с хвостом
# затянувшейся копии не хочется — дамп и массовое удаление на одном диске
# мешают друг другу.
RandomizedDelaySec=10m
# Сервер был выключен в назначенный час — уборка пройдёт при первом запуске.
# Пропуск не смертелен (следующий прогон доберёт), но и копить работу незачем:
# чем длиннее хвост, тем дольше прогон упирается в предел времени.
Persistent=true

[Install]
WantedBy=timers.target
