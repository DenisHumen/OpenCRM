[Unit]
Description=OpenCRM: утренняя сводка раз в сутки

[Timer]
# 09:00 по Киеву. Пояс назван явно, а не пересчитан в UTC руками: перевод на
# зимнее время systemd учтёт сам, а записанное числом 06:00 UTC осенью уехало
# бы на час и молча.
#
# Пояс стоит ВНУТРИ календарного выражения. Отдельного ключа `Timezone=` в
# секции `[Timer]` у systemd не существует: он пишет в журнал «Unknown key name
# 'Timezone' in section 'Timer', ignoring» и идёт по времени сервера. На UTC-VPS
# это означало сводку в 11:00–12:00 по Киеву вместо девяти — юнит при этом
# запускался, ошибки не показывал, и разошлось бы только расписание.
# Пояс в выражении systemd понимает с версии 235; целевая Ubuntu 24.04 — 255.
OnCalendar=*-*-* 09:00:00 Europe/Kyiv
# Разброса здесь НЕТ намеренно, в отличие от резервной копии. Копия уводится с
# пика соседей по железу, а сводка — это сообщение человеку: «письмо приходит к
# девяти» ценнее, чем «где-то между девятью и половиной десятого».
#
# Сервер был выключен в назначенный час — сводка уйдёт при первом запуске, а не
# пропустится молча. Пропущенная сводка означала бы ложную тревогу: её
# отсутствие и есть сигнал, что что-то сломалось.
Persistent=true

[Install]
WantedBy=timers.target
