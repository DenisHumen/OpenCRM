# Автообновление сайта (scripts/autoupdate.py). Скопируйте в ~/opencrm/autoupdate.env
# и пропишите путь к нему в systemd-юните (deploy/systemd/opencrm-autoupdate.service).
#
# Файл читает демон на хосте, а не приложение: настройки самой CRM живут
# отдельно, в config/.env.

# --- что отслеживаем ---
OPENCRM_UPDATE_REPO=DenisHumen/OpenCRM
OPENCRM_UPDATE_BRANCH=main
# Как часто спрашивать GitHub, секунды. Анонимный лимит API — 60 запросов в час,
# опрос раз в 5 минут укладывается в 12 (а «ничего не изменилось» приходит 304).
OPENCRM_UPDATE_POLL_SECONDS=300
# Токен нужен только чтобы поднять лимит или читать приватный репозиторий.
# Права: `Contents: read`. Пусто — ходим анонимно.
#OPENCRM_UPDATE_GITHUB_TOKEN=

# --- где что лежит ---
# ВАЖНО: та же переменная, что читает docker-compose.yml. Демон запускает compose
# со своим окружением, и если здесь путь разойдётся с тем, под которым вы
# поднимали стек руками, — примонтируются разные каталоги, и сайт после
# обновления окажется с пустой базой. Указывайте явно, не полагаясь на $HOME:
# у systemd-службы он не обязан совпадать с вашим.
OPENCRM_HOME=/home/studio/opencrm

# Чекаут репозитория на сервере. По умолчанию — каталог, из которого запущен скрипт.
#OPENCRM_UPDATE_PROJECT_DIR=/opt/OpenCRM
# Состояние и снимки базы; по умолчанию $OPENCRM_HOME/updates.
#OPENCRM_UPDATE_STATE_DIR=/home/studio/opencrm/updates
#OPENCRM_UPDATE_DATA_DIR=/home/studio/opencrm/data

# --- проверка живого сайта после деплоя ---
# /healthz ходит в базу — «контейнер поднялся» этого не доказывает.
OPENCRM_UPDATE_HEALTH_URL=http://127.0.0.1/healthz
# Плюс настоящие страницы, через nginx. Несколько — через запятую.
OPENCRM_UPDATE_SMOKE_URLS=http://127.0.0.1/
# Сколько ждать: 30 попыток по 4 секунды = две минуты на подъём после сборки.
OPENCRM_UPDATE_HEALTH_ATTEMPTS=30
OPENCRM_UPDATE_HEALTH_DELAY=4

# --- уведомления ---
# Бот создаётся у @BotFather; chat_id личного чата подскажет @userinfobot.
# Пусто — обновление работает молча, исход виден в `autoupdate.py status`.
#OPENCRM_UPDATE_TELEGRAM_TOKEN=
#OPENCRM_UPDATE_TELEGRAM_CHAT=

# --- предохранители ---
# 0 — не гонять тесты перед деплоем. Включать только если разбираетесь вручную:
# это единственная проверка, которая ловит поломку ДО того, как её увидит клиент.
#OPENCRM_UPDATE_RUN_CHECKS=1
# 1 — обновляться даже поверх несохранённых правок в рабочем дереве (затрёт их).
#OPENCRM_UPDATE_ALLOW_DIRTY=0
