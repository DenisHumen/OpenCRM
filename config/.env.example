# ШАБЛОН. Скопируйте в config/.env и заполните — реальные значения держите только
# там (config/.env в .gitignore, этот файл коммитится).
# Все переменные с префиксом OPENCRM_.

# dev — локальный запуск; production — боевой сервер. В production приложение
# не стартует с пустыми секретами ниже и выдаёт cookie с флагом Secure (нужен HTTPS).
OPENCRM_ENV=production

# Обязательно в production: подписывает cookie сессий и PIN-доступа к доскам.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))"
OPENCRM_SECRET_KEY=

# На чём работает база. Спрашивается один раз при `./opencrm.sh install`, и
# записанное здесь значение — единственный признак выбора: по нему и приложение
# находит данные, и копии понимают, снимать файл или дамп.
#
#   SQLite — ничего ставить не нужно, база лежит одним файлом:
# OPENCRM_DB_URL=sqlite:////app/data/opencrm.db
#
#   MySQL — отдельный контейнер рядом (служба db под профилем mysql в
#   docker/docker-compose.yml). Пароль сюда пишет установщик; он же кладёт
#   ТОТ ЖЕ пароль в docker/.env, откуда его берёт контейнер базы. Меняя пароль
#   руками, правьте оба файла — разойдясь, они дадут «access denied» на старте:
# OPENCRM_DB_URL=mysql+pymysql://opencrm:ПАРОЛЬ@db:3306/opencrm?charset=utf8mb4
#
# charset=utf8mb4 обязателен: без него соединение договаривается о трёхбайтном
# utf8, и эмодзи в заметке клиента обрывают вставку на полуслове.
OPENCRM_DB_URL=sqlite:///data/opencrm.db

# Общий на все рабочие процессы счётчик неудачных попыток: вход сотрудника,
# PIN публичной ссылки, обращения к бланкам, поток заявок с формы, вебхук АТС.
#
# Служба redis поднимается вместе со стеком ВСЕГДА, профиля у неё нет: без
# общего счётчика защита от подбора держится на памяти процесса, и при
# нескольких процессах порог молча умножается на их число. Поэтому в
# production пустое значение — отказ старта, а не «работаем как есть».
#
# Пароль сюда пишет установщик; он же кладёт ТОТ ЖЕ пароль в docker/.env,
# откуда его берёт контейнер Redis. Правите руками — правьте оба файла.
#
# Пусто можно оставить ровно в одном сочетании: OPENCRM_ENV=dev и один рабочий
# процесс (ноутбук, набор тестов). Там счётчик в памяти процесса и есть общий.
#
# Вид значения (пароль без имени пользователя — у Redis его нет):
#   OPENCRM_REDIS_URL=redis://:ПАРОЛЬ@redis:6379/0
#
# Оставлено пустым нарочно: подставленный сюда образец с словом «ПАРОЛЬ» прошёл
# бы проверку конфига и упал бы уже на первом входе — а пустое значение
# останавливает старт с внятной строкой о том, чего не хватает.
OPENCRM_REDIS_URL=

OPENCRM_STORAGE_DIR=./storage

# Домен, на который ведут публичные ссылки на доски и OG-превью в мессенджерах.
OPENCRM_BASE_URL=https://studio.example.com

# Используются ТОЛЬКО при создании root на первом старте пустой базы.
# Пароль — минимум 10 символов. Если root уже создан, менять эти значения
# бесполезно: логин и пароль меняются командой `python scripts/reset_root.py`.
OPENCRM_ROOT_EMAIL=
OPENCRM_ROOT_PASSWORD=

OPENCRM_MAX_UPLOAD_MB=200

# Контроль места на диске: предупреждение и «критично» в процентах занятого,
# и аварийный запас в МБ, ниже которого загрузка файлов блокируется.
OPENCRM_DISK_WARNING_PERCENT=80
OPENCRM_DISK_CRITICAL_PERCENT=90
OPENCRM_DISK_MIN_FREE_MB=1024

# Обязательно в production: соль для хэширования IP в журнале просмотров витрин.
OPENCRM_IP_HASH_SALT=

# Сколько ДОВЕРЕННЫХ обратных прокси стоит перед приложением. Определяет, какому
# адресу в X-Forwarded-For верить (rate-limit подбора PIN, хэш IP просмотров).
#   0 — приложение смотрит наружу напрямую (без nginx): X-Forwarded-For игнорируется.
#   1 — боевая схема из docs/08 (один nginx): реальный IP клиента — последний элемент,
#       дописанный nginx; левые (их шлёт клиент) не в счёт. За каждый лишний прокси +1.
# ВАЖНО: uvicorn запускается с --no-proxy-headers (см. docker/entrypoint.sh), иначе он
# сам перепишет client по заголовку и подмена снова станет возможной.
#
# ЗАПУСК В DOCKER: здесь значение не работает. В docker-compose.yml переменная
# задана через `environment`, а он перекрывает `env_file` — правьте docker/.env.
# Эта строка нужна тем, кто запускает приложение без compose.
OPENCRM_TRUSTED_PROXY_HOPS=1
