# Что НЕ отправлять демону Docker при сборке.
# Без этого файла в контекст уезжало ~230 МБ (.venv, node_modules, tmp, storage),
# и каждое автообновление платило за это временем сборки на ровном месте.

# Окружения и кэши — в образе они не нужны и всё равно пересобираются
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
node_modules/

# Состояние, а не исходники: база, медиа и бэкапы монтируются томами
data/
storage/
tmp/

# Секреты. Compose передаёт их в контейнер через env_file во время запуска —
# в слое образа им делать нечего: слои читает любой, у кого есть образ.
config/.env
docker/.env
**/*.env
!**/.env.example

# Уезжает вместе с .git история всех веток — а Dockerfile из неё ничего не берёт
.git/
.github/

# Собранный локально фронтенд: в образе его собирает отдельный этап node,
# и подсунутый снаружи dist затёр бы свежую сборку
web/frontend/crm/dist/

# Макеты и заметки — ни один этап их не копирует
design/
.claude/
*.md

# docs/ — исключение, и оно осознанное. В БОЕВОЙ образ документы не едут (этап
# `app` их не копирует), но этап `tests` копирует: `test_api_dokumentirovan.py`
# сверяет справочник API с настоящими маршрутами. Пока каталог был исключён,
# сторож падал в контейнере на `FileNotFoundError`, будучи зелёным на машине
# разработчика, — ровно тот класс беды, что уже случался с `nagruzka/`.
!docs/
!docs/**

# Корневые документы — по той же причине и с тем же уроком, что docs/.
# `tests/test_ssylki_dokumentov.py` идёт по ссылкам документации, а из docs/
# ссылаются на CLAUDE.md и README.md; без них сторож краснел в образе гейта,
# будучи зелёным снаружи (06.09.2026). Приложению они не нужны: этап `app`
# их не копирует.
!CLAUDE.md
!README.md
!README.ru.md

# ВНИМАНИЕ: tests/ и deploy/ здесь быть НЕ должно. Их копирует этап `tests`
# (docker/Dockerfile), которым автообновление проверяет новый код перед деплоем;
# исключив их, мы бы молча сломали единственную проверку, стоящую между
# сломанным коммитом и живым сайтом. В боевой образ они не попадают всё равно —
# этап `app` их не копирует.
